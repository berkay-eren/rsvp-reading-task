        <Param val="sentence = &quot;My father takes me to school every day in his big green car&quot;;&amp;#10;words = sentence.split(&quot; &quot;);&amp;#10;currentWord = &quot;&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
