  <Flow>
    <Routine name="instructions"/>
    <Routine name="practice_instructions"/>
    <LoopInitiator loopType="TrialHandler" name="practice_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'sentence_id': 'P1', 'sentence': 'The little boy walked to school with his sister this morning'}, {'sentence_id': 'P2', 'sentence': 'Sarah put her red book on the table before eating dinner'}, {'sentence_id': 'P3', 'sentence': 'The family took a bus to the park on Sunday morning'}]" valType="str"/>
