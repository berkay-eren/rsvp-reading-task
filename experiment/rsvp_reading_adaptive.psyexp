      <CodeComponent name="staircase_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="response = experimenter_key.keys;&amp;#10;if ((response === &quot;1&quot;)) {&amp;#10;    correctStreak += 1;&amp;#10;    if ((correctStreak &gt;= 2)) {&amp;#10;        wordDuration = Math.max(minDuration, (wordDuration - stepSize));&amp;#10;        correctStreak = 0;&amp;#10;    }&amp;#10;} else {&amp;#10;    if ((response === &quot;0&quot;)) {&amp;#10;        wordDuration = Math.min(maxDuration, (wordDuration + stepSize));&amp;#10;        correctStreak = 0;&amp;#10;    }&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;staircase_response&quot;, response);&amp;#10;psychoJS.experiment.addData(&quot;nextWordDuration&quot;, wordDuration);&amp;#10;psychoJS.experiment.addData(&quot;correctStreak&quot;, correctStreak);&amp;#10;console.log(&quot;Response:&quot;, response);&amp;#10;console.log(&quot;Next word duration:&quot;, wordDuration);&amp;#10;console.log(&quot;Correct streak:&quot;, correctStreak);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Get experimenter's response&amp;#10;response = experimenter_key.keys&amp;#10;&amp;#10;# Track duration change&amp;#10;direction = 0&amp;#10;&amp;#10;# 2-down / 1-up staircase&amp;#10;if response == '1':&amp;#10;    correctStreak += 1&amp;#10;&amp;#10;    if correctStreak &gt;= 2:&amp;#10;        newDuration = max(minDuration, wordDuration - stepSize)&amp;#10;&amp;#10;        if newDuration &lt; wordDuration:&amp;#10;            direction = -1  # Faster&amp;#10;&amp;#10;        wordDuration = newDuration&amp;#10;        correctStreak = 0&amp;#10;&amp;#10;elif response == '0':&amp;#10;    newDuration = min(maxDuration, wordDuration + stepSize)&amp;#10;&amp;#10;    if newDuration &gt; wordDuration:&amp;#10;        direction = 1  # Slower&amp;#10;&amp;#10;    wordDuration = newDuration&amp;#10;    correctStreak = 0&amp;#10;&amp;#10;# Detect reversals&amp;#10;if direction != 0:&amp;#10;    if lastDirection != 0 and direction != lastDirection:&amp;#10;        reversalCount += 1&amp;#10;        reversalDurations.append(wordDuration)&amp;#10;&amp;#10;        print(&quot;REVERSAL:&quot;, reversalCount,&amp;#10;              &quot;Duration:&quot;, wordDuration)&amp;#10;&amp;#10;    lastDirection = direction&amp;#10;&amp;#10;# Save sentence-level data&amp;#10;thisExp.addData('sentenceID', sentence_id)&amp;#10;thisExp.addData('sentenceText', sentence)&amp;#10;thisExp.addData('sentenceWordCount', len(words))&amp;#10;thisExp.addData('sentenceWordDuration', sentenceWordDuration)&amp;#10;&amp;#10;# Experimenter response&amp;#10;thisExp.addData('staircase_response', response)&amp;#10;&amp;#10;# Staircase state after response&amp;#10;thisExp.addData('nextWordDuration', wordDuration)&amp;#10;thisExp.addData('correctStreak', correctStreak)&amp;#10;thisExp.addData('staircaseDirection', direction)&amp;#10;thisExp.addData('reversalCount', reversalCount)&amp;#10;&amp;#10;print(&quot;Response:&quot;, response)&amp;#10;print(&quot;Next word duration:&quot;, wordDuration)&amp;#10;print(&quot;Correct streak:&quot;, correctStreak)&amp;#10;print(&quot;Reversals:&quot;, reversalCount)&amp;#10;    &amp;#10;# Write one row per sentence&amp;#10;sentenceWriter.writerow([&amp;#10;    expInfo['participant'],&amp;#10;    expInfo['session'],&amp;#10;    sentence_id,&amp;#10;    sentence,&amp;#10;    len(words),&amp;#10;    sentenceWordDuration,&amp;#10;    response,&amp;#10;    wordDuration,&amp;#10;    correctStreak,&amp;#10;    direction,&amp;#10;    reversalCount&amp;#10;])&amp;#10;&amp;#10;# Save data to disk&amp;#10;sentenceDataFile.flush()&amp;#10;    &amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="staircase_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
